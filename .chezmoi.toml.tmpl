[data]
    isWork = {{ promptBoolOnce "isWork" "Work machine" false }}
    email = "{{ promptStringOnce "email" "Email" "thebriankwon@gmail.com" }}"

[merge]
    command = "nvim"
    args = [
        "-d",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
